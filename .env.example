# Copy to .env (git-ignored). The test client loads it automatically on start.
# Google: https://console.cloud.google.com/apis/credentials → Create credentials → OAuth client ID → Web application
#   Authorized redirect URI: http://localhost:4000/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_SCOPES="openid email profile"
# GOOGLE_API_URL=          # optional Google API to call on /profile (needs matching scope)
# GOOGLE_PROMPT=consent    # "consent" guarantees a refresh token each login
